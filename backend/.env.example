# Copie este arquivo para ".env" e preencha com os valores reais.
# Chave "Web API Key" do projeto Firebase (Console -> Configurações do projeto -> Geral)
FIREBASE_WEB_API_KEY=

# Opcional: host do Firebase Auth Emulator para desenvolver sem tocar no projeto real.
# Ex.: localhost:9099  (deixe vazio para usar o Firebase de verdade)
FIREBASE_AUTH_EMULATOR_HOST=
